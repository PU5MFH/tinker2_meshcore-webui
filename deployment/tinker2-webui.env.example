MESHCORE_HOST=192.168.100.213
MESHCORE_PORT=5000
DATABASE_URL=sqlite+aiosqlite:////var/log/tinker2-meshcore-webui/meshcore.db
STATIC_DIR=/opt/tinker2-meshcore-webui/static
VAPID_PRIVATE_KEY_PATH=/etc/tinker2-meshcore-webui/vapid_private.pem
MESHCORE_WEBUI_RX_LOG_PERSIST=true
MESHCORE_WEBUI_RX_LOG_BUFFER_SIZE=1000
MESHCORE_WEBUI_RX_LOG_PERSIST_MAX_ROWS=1000
MESHCORE_WEBUI_NOISE_POLL_INTERVAL_S=10
MESHCORE_WEBUI_TILE_CACHE_DIR=/var/log/tinker2-meshcore-webui/tile-cache
ATTACHMENTS_DIR=/var/log/tinker2-meshcore-webui/attachments
ATTACHMENTS_MAX_BYTES=5242880
ATTACHMENTS_QUOTA_BYTES=20971520
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
TZ=America/Sao_Paulo
PUBLIC_BASE_URL=http://192.168.100.224:8090
